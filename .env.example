PORT=3000

JWT_SECRET=
JWT_EXPIRES_IN=8h

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=mirage

AGENT_PROVIDER=gemini
AGENT_TOKEN_LIMIT=200000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024

# Lectura de PDFs (proformas). Por defecto usa AGENT_PROVIDER y su modelo; su consumo no cuenta contra AGENT_TOKEN_LIMIT.
EXTRACTOR_PROVIDER=
GEMINI_EXTRACTOR_MODEL=
ANTHROPIC_EXTRACTOR_MODEL=
EXTRACCION_ESPERA_MS=25000

# Lectura de SharePoint (Microsoft Graph): Excel Madre, carpetas de OP, cotizaciones y PIs. Solo lectura.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SHARE_URL=
SHAREPOINT_OPS_FOLDER_URL=

# Clave de la tarea programada que lanza la sincronización diaria (mínimo 24 caracteres; ver docs/DESPLIEGUE.md §4b).
# Sin definir, el acceso por token queda desactivado. Generar una con: openssl rand -hex 32
CRON_TOKEN=
